{
  "name": "year-end-party-battle",
  "version": "1.0.0",
  "private": true,
  "description": "송년회 랜덤 미니게임 배틀 - QR 기반 실시간 멀티플레이어 미니게임",
  "scripts": {
    "dev": "tsx watch --ignore ./src/app --ignore ./src/components server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify-data.ts && tsx scripts/sim.ts",
    "verify:data": "tsx scripts/verify-data.ts",
    "sim": "tsx scripts/sim.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cross-env": "^10.1.0",
    "framer-motion": "^14.12.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
